{
  "name": "orders",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --config lint.config.js .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc --noEmit && setu build",
    "start": "node --input-type=commonjs -e \"require('node:fs').existsSync('dist/main.js')||(console.error('dist/main.js is missing; run the build script first'),process.exitCode=1)\" && node --import ./instrumentation.mjs --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "start:dev": "tsx watch --import ./instrumentation.mjs --env-file-if-exists=.env main.ts",
    "start:debug": "node --import ./instrumentation.mjs --env-file-if-exists=.env --inspect=127.0.0.1:5411 --import tsx main.ts",
    "test": "tsx --test --test-force-exit '**/!(*.e2e).test.ts'",
    "test:e2e": "tsx --test --test-force-exit '**/*.e2e.test.ts'"
  },
  "dependencies": {
    "@setu-ts/common": "workspace:^",
    "@setu-ts/kernel": "workspace:^",
    "@setu-ts/runtime": "workspace:^",
    "@setu-ts/config-plugin": "workspace:^",
    "@setu-ts/logger-plugin": "workspace:^",
    "@setu-ts/validation-plugin": "workspace:^",
    "@setu-ts/http-security-plugin": "workspace:^",
    "@setu-ts/health-plugin": "workspace:^",
    "@setu-ts/metrics-plugin": "workspace:^",
    "@setu-ts/openapi-plugin": "workspace:^",
    "@setu-ts/messaging-plugin": "workspace:^",
    "@setu-ts/queue-plugin": "workspace:^",
    "@setu-ts/resilience-plugin": "workspace:^",
    "@setu-ts/telemetry-plugin": "workspace:^",
    "@setu-ts/cqrs-plugin": "workspace:^",
    "@setu-ts/events-plugin": "workspace:^",
    "@setu-ts/service-discovery-plugin": "workspace:^",
    "@setu-ts/exceptions": "workspace:^",
    "@grpc-workspace/contracts": "workspace:*",
    "pino": "10.x",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2",
    "swagger-ui-dist": "5.33.3",
    "zod": "^4.6.6"
  },
  "scarfSettings": {
    "enabled": false
  },
  "devDependencies": {
    "@setu-ts/testing": "workspace:^",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "@setu-ts/cli": "workspace:^"
  }
}
