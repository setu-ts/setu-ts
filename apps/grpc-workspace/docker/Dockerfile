# Generated by `setu`. Build from the workspace root.
FROM node:24-alpine AS build
ARG MEMBER
WORKDIR /srv
COPY package.json package-lock.json* ./
COPY apps/${MEMBER}/package.json ./apps/${MEMBER}/
COPY lib[s] ./libs/

ARG NPM_CONFIG_REGISTRY=
RUN --mount=type=secret,id=npmrc,target=/root/.npmrc if [ -z "$NPM_CONFIG_REGISTRY" ]; then unset NPM_CONFIG_REGISTRY; fi && npm ci
COPY apps/${MEMBER} ./apps/${MEMBER}
RUN npm run build --workspace apps/${MEMBER}

FROM node:24-alpine AS runtime
ARG MEMBER
WORKDIR /srv
COPY package.json package-lock.json* ./
COPY apps/${MEMBER}/package.json ./apps/${MEMBER}/
COPY lib[s] ./libs/

ARG NPM_CONFIG_REGISTRY=
RUN --mount=type=secret,id=npmrc,target=/root/.npmrc if [ -z "$NPM_CONFIG_REGISTRY" ]; then unset NPM_CONFIG_REGISTRY; fi && npm ci --omit=dev --workspace apps/${MEMBER} --workspace libs
WORKDIR /srv/apps/${MEMBER}
COPY --from=build /srv/apps/${MEMBER}/dist ./dist
COPY --from=build /srv/apps/${MEMBER}/instrumentation.mjs ./
COPY --from=build /srv/apps/${MEMBER}/buil[d] ./build/
# NUMERIC, not a name: Kubernetes can verify this user is non-root.
USER 1000:1000
CMD ["node", "--import", "./instrumentation.mjs", "--enable-source-maps", "dist/main.js"]
