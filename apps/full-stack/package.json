{
  "name": "setu-ts-example-full-stack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "react-router build && pnpm --workspace-root exec tsc -p apps/full-stack/tsconfig.json --noEmit",
    "lint": "eslint --config lint.config.js .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "react-router build && tsc --noEmit && setu build",
    "start": "node --input-type=commonjs -e \"require('node:fs').existsSync('dist/main.js')||(console.error('dist/main.js is missing; run the build script first'),process.exitCode=1)\" && node --import \"data:text/javascript,process.env.NODE_ENV??='production'\" --import ./instrumentation.mjs --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "start:dev": "tsx --import ./instrumentation.mjs --env-file-if-exists=.env dev.ts",
    "start:debug": "node --import ./instrumentation.mjs --env-file-if-exists=.env --inspect --import tsx dev.ts",
    "test": "react-router build && tsx --test --test-force-exit '**/!(*.e2e|*.browser).test.ts'",
    "test:e2e": "react-router build && tsx --test --test-force-exit '**/*.e2e.test.ts'",
    "smoke": "react-router build && tsx smoke.ts",
    "browser": "node browser/harness.ts"
  },
  "dependencies": {
    "@setu-ts/common": "workspace:^",
    "@setu-ts/kernel": "workspace:^",
    "@setu-ts/runtime": "workspace:^",
    "@setu-ts/full-stack-starter": "workspace:^",
    "@setu-ts/exceptions": "workspace:^",
    "@setu-ts/session-plugin": "workspace:^",
    "@setu-ts/react-router-plugin": "workspace:^",
    "pino": "10.x",
    "cn": "^0.5.0",
    "lucide-react": "1.67.0",
    "class-variance-authority": "^0.7.1",
    "radix-ui": "^1.8.1",
    "react-router": "^8.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "swagger-ui-dist": "5.33.3",
    "zod": "^4.6.6",
    "@setu-ts/database-plugin": "workspace:^",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@setu-ts/testing": "workspace:^",
    "@types/node": "^24.0.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "@setu-ts/cli": "workspace:^",
    "@react-router/dev": "^8.0.0",
    "@react-router/fs-routes": "^8.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "vite": "^8.0.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "playwright": "1.63.0",
    "vitest": "5.0.3"
  }
}
