{
  "name": "setu-ts-example-full-stack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "pnpm run build && tsx main.ts",
    "smoke": "pnpm run build && tsx smoke.ts",
    "check": "pnpm --workspace-root exec tsc -p apps/full-stack/tsconfig.json --noEmit",
    "build": "react-router build",
    "test": "vitest run --config vitest.config.ts",
    "browser": "node browser/harness.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.0.0",
    "tsx": "^4.20.6",
    "@setu-ts/common": "workspace:^",
    "@setu-ts/database-plugin": "workspace:^",
    "@setu-ts/kernel": "workspace:^",
    "@setu-ts/runtime": "workspace:^",
    "@setu-ts/react-router-plugin": "workspace:^",
    "@setu-ts/session-plugin": "workspace:^",
    "@setu-ts/full-stack-starter": "workspace:^"
  },
  "devDependencies": {
    "@react-router/dev": "^8.0.0",
    "@react-router/fs-routes": "^8.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.0.0",
    "typescript": "^5.9.2",
    "vite": "^8.0.0",
    "playwright": "1.63.0",
    "vitest": "5.0.3"
  }
}
