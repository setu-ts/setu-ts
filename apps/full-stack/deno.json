{
  "nodeModulesDir": "auto",
  "tasks": {
    "install": "deno install --allow-scripts",
    "build": "deno task install && deno run -A npm:@react-router/dev build",
    "check:app": "deno check app/**/*.ts app/**/*.tsx",
    "start": "deno task build && deno run --allow-net --allow-env --allow-read main.ts",
    "smoke": "deno task build && deno run -A smoke.ts",
    "test": "deno task check:app && deno test -A test/"
  },
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ]
  },
  "imports": {
    "@std/expect": "jsr:@std/expect@^1.0.20",
    "@std/testing": "jsr:@std/testing@^1.0.19",
    "@setu-ts/common": "../../packages/common/src/index.ts",
    "@setu-ts/database-plugin": "../../packages/database-plugin/src/index.ts",
    "@setu-ts/kernel": "../../packages/kernel/src/index.ts",
    "@setu-ts/react-router-plugin": "../../packages/react-router-plugin/src/index.ts",
    "@setu-ts/session-plugin": "../../packages/session-plugin/src/index.ts",
    "@setu-ts/full-stack-starter": "../../packages/starters/full-stack-starter/src/index.ts",
    "~/": "./app/"
  }
}
