# Generated by `setu`. Build from the project root.
FROM node:24-alpine AS build
WORKDIR /srv
COPY package.json package-lock.json* ./

ARG NPM_CONFIG_REGISTRY=
RUN --mount=type=secret,id=npmrc,target=/root/.npmrc if [ -z "$NPM_CONFIG_REGISTRY" ]; then unset NPM_CONFIG_REGISTRY; fi && npm ci
COPY . .
RUN npm run build

FROM node:24-alpine AS runtime
WORKDIR /srv
COPY package.json package-lock.json* ./

ARG NPM_CONFIG_REGISTRY=
RUN --mount=type=secret,id=npmrc,target=/root/.npmrc if [ -z "$NPM_CONFIG_REGISTRY" ]; then unset NPM_CONFIG_REGISTRY; fi && npm ci --omit=dev
WORKDIR /srv
COPY --from=build /srv/dist ./dist
COPY --from=build /srv/instrumentation.mjs ./
COPY --from=build /srv/buil[d] ./build/
# NUMERIC, not a name: Kubernetes can verify this user is non-root.
USER 1000:1000
CMD ["node", "--import", "./instrumentation.mjs", "--enable-source-maps", "dist/main.js"]
