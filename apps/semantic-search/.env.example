# Copy this file to `.env` and fill in local values.
# `.env` is ignored by Git; this example is committed.

# Any OpenAI-compatible embeddings server; the defaults are llama.cpp serving
# Qwen3-Embedding-0.6B on port 8081. EMBED_DIMENSIONS must match the model.
EMBED_BASE_URL=http://localhost:8081/v1
EMBED_MODEL=qwen3-embedding-0.6b
EMBED_DIMENSIONS=1024
# EMBED_API_KEY=

# Unset: vectors live in process memory. Set: PostgreSQL with pgvector 0.8+.
# PGVECTOR_URL=postgres://postgres:postgres@localhost:5432/postgres
