# Copy this file to `.env` and fill in local values.
# `.env` is ignored by Git; this example is committed.

# Any OpenAI-compatible chat server with tool calling; the defaults are a
# llama.cpp server on port 8080. AI_COMPAT_API_KEY is only for hosted APIs.
AI_COMPAT_BASE_URL=http://localhost:8080/v1
AI_COMPAT_MODEL=local
# AI_COMPAT_API_KEY=

# Unset: the memory database, which loses every run when the process stops.
# Set: PostgreSQL; run `npm run db:setup` once to create the tables.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# PORT=3000
