{
  "name": "@setu-ts/static-plugin",
  "version": "0.1.0-alpha.5",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "@setu-ts/common": "jsr:@setu-ts/common@^0.1.0-alpha.5",
    "@setu-ts/kernel": "jsr:@setu-ts/kernel@^0.1.0-alpha.5",
    "@setu-ts/runtime": "jsr:@setu-ts/runtime@^0.1.0-alpha.5",
    "@setu-ts/testing": "jsr:@setu-ts/testing@^0.1.0-alpha.5"
  },
  "test": {
    "permissions": {
      "read": true,
      "write": true,
      "env": true,
      "sys": ["hostname", "cpus"],
