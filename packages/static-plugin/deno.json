{
  "name": "@setu-ts/static-plugin",
  "version": "0.8.0",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "test": {
    "permissions": {
      "read": true,
      "write": true,
      "env": true,
      "sys": [
        "hostname",
        "cpus"
      ],
      "net": true
    }
  },
  "tasks": {
    "test": "deno test --trace-leaks",
    "test:coverage": "deno test --coverage=coverage"
  }
}
