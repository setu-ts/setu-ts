{
  "name": "@setu-ts/view-plugin",
  "version": "0.5.0",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "@setu-ts/common": "jsr:@setu-ts/common@^0.5.0",
    "@setu-ts/kernel": "jsr:@setu-ts/kernel@^0.5.0",
    "@setu-ts/runtime": "jsr:@setu-ts/runtime@^0.5.0",
    "@setu-ts/testing": "jsr:@setu-ts/testing@^0.5.0",
    "@setu-ts/decorator-plugin": "jsr:@setu-ts/decorator-plugin@^0.5.0",
    "@hono/hono": "jsr:@hono/hono@^4.12.30"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@hono/hono/jsx"
  },
  "test": {
    "permissions": {
      "read": true,
      "write": true,
      "env": true,
      "sys": ["hostname", "cpus"],
      "net": true
    }
  },
  "tasks": {
    "test": "deno test --trace-leaks",
    "test:coverage": "deno test --coverage=coverage"
  }
}
