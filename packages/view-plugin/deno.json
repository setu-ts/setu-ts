{
  "name": "@setu-ts/view-plugin",
  "version": "0.11.0",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "test": {
    "permissions": {
      "read": true,
      "write": true,
      "env": true,
      "sys": [
        "hostname",
        "cpus"
      ],
      "net": true
    }
  },
  "tasks": {
    "test": "deno test --trace-leaks",
    "test:coverage": "deno test --coverage=coverage"
  },
  "imports": {
    "hono/html": "npm:hono@^4.12.30/html",
    "hono/jsx": "npm:hono@^4.12.30/jsx",
    "hono/utils/html": "npm:hono@^4.12.30/utils/html",
    "vitest": "npm:vitest@5.0.3"
  }
}
