{
  "name": "@setu-ts/auth-plugin",
  "version": "0.10.0",
  "license": "MIT",
  "exports": "./src/index.ts",
  "test": {
    "permissions": {
      "read": true,
      "import": true,
      "env": true,
      "sys": ["hostname"],
      "net": [
        "127.0.0.1:6379",
        "localhost:6379",
        "localhost:8180"
      ],
      "run": [
        "docker"
      ]
    }
  },
  "imports": {
    "@node-saml/node-saml": "npm:@node-saml/node-saml@^5",
    "@simplewebauthn/server": "npm:@simplewebauthn/server@14.0.3",
    "ioredis": "npm:ioredis@5.x",
    "redis": "npm:redis@6.x",
    "vitest": "npm:vitest@5.0.3",
    "xml-crypto": "npm:xml-crypto@^6"
  }
}
