{
  "name": "@setu-ts/database-plugin",
  "version": "0.8.0",
  "license": "MIT",
  "exports": "./src/index.ts",
  "exclude": [
    "test/fixtures/prisma-client-generated"
  ],
  "test": {
    "permissions": {
      "read": true,
      "import": true,
      "env": true,
      "sys": [
        "hostname",
        "osRelease"
      ],
      "net": [
        "127.0.0.1:27017",
        "localhost:27017",
        "127.0.0.1:5433",
        "127.0.0.1:8000",
        "127.0.0.1:8082",
        "127.0.0.1:8086",
        "127.0.0.1:1"
      ]
    }
  },
  "imports": {
    "@aws-sdk/client-dynamodb": "npm:@aws-sdk/client-dynamodb@^3",
    "@azure/cosmos": "npm:@azure/cosmos@^4",
    "@google-cloud/bigtable": "npm:@google-cloud/bigtable@^6",
    "drizzle-orm": "npm:drizzle-orm@0.45.2",
    "mongodb": "npm:mongodb@^6.21.0"
  }
}
