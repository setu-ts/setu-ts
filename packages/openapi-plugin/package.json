{
  "name": "@setu-ts/openapi-plugin",
  "version": "0.11.0",
  "description": "OpenAPI 3.1 generated from routes, with a Zod transformer and Swagger UI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/setu-ts/setu-ts.git",
    "directory": "packages/openapi-plugin"
  },
  "homepage": "https://github.com/setu-ts/setu-ts/tree/main/packages/openapi-plugin",
  "bugs": {
    "url": "https://github.com/setu-ts/setu-ts/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "AGENT_CARD.md"
