    }
  },
  "devDependencies": {
    "@setu-ts/auth-plugin": "workspace:^",
    "@setu-ts/decorator-plugin": "workspace:^",
    "@setu-ts/health-plugin": "workspace:^",
    "@setu-ts/kernel": "workspace:^",
    "@setu-ts/metrics-plugin": "workspace:^",
    "@setu-ts/runtime": "workspace:^",
    "@setu-ts/validation-plugin": "workspace:^",
    "@types/node": "^24",
    "@types/swagger-ui-dist": "^3.30.6",
    "swagger-ui-dist": "^5",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "zod-v4": "npm:zod@^4.6.6"
  }
