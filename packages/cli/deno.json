{
  "name": "@setu-ts/cli",
  "version": "0.8.0",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./main": "./src/main.ts"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-console"
      ]
    }
  },
  "test": {
    "permissions": {
      "read": true,
      "write": true,
      "env": true,
      "sys": [
        "hostname",
        "cpus"
      ],
      "net": [
        "127.0.0.1"
      ],
      "run": [
        "deno",
        "npm"
      ]
    }
  },
  "imports": {
    "prettier": "npm:prettier@^3.9.10",
    "tsx/esm/api": "npm:tsx@^4.23.0/esm/api",
    "vitest": "npm:vitest@5.0.3"
  }
}
