{
  "name": "@setu-ts/localization-plugin",
  "version": "0.8.0",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./format": "./src/format/index.ts"
  },
  "test": {
    "permissions": {
      "read": true,
      "write": [
        "."
      ],
      "env": true,
      "run": [
        "deno"
      ],
      "sys": [
        "hostname",
        "cpus"
      ]
    }
  },
  "tasks": {
    "test": "deno test --trace-leaks",
    "test:coverage": "deno test --coverage=coverage"
  }
}
