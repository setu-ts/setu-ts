{
  "name": "@setu-ts/localization-plugin",
  "version": "0.8.0",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./format": "./src/format/index.ts"
  },
  "imports": {
    "@setu-ts/common": "jsr:@setu-ts/common@^0.8.0",
    "@setu-ts/kernel": "jsr:@setu-ts/kernel@^0.8.0",
    "@setu-ts/runtime": "jsr:@setu-ts/runtime@^0.8.0",
    "@setu-ts/testing": "jsr:@setu-ts/testing@^0.8.0",
    "@setu-ts/view-plugin": "jsr:@setu-ts/view-plugin@^0.8.0",
    "@setu-ts/cache-plugin": "jsr:@setu-ts/cache-plugin@^0.8.0",
    "@setu-ts/multi-tenancy-plugin": "jsr:@setu-ts/multi-tenancy-plugin@^0.8.0",
    "@setu-ts/exceptions": "jsr:@setu-ts/exceptions@^0.8.0",
    "@hono/hono": "jsr:@hono/hono@^4.12.30"
  },
  "test": {
    "permissions": {
      "read": true,
      "write": true,
      "env": true,
      "run": true,
      "sys": [
