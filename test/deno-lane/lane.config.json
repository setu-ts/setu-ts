{
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "lib": [
      "deno.ns",
      "deno.window",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "nodeModulesDir": "auto",
  "permissions": {
    "runtime": {
      "sys": [
        "hostname",
        "cpus"
      ],
      "net": true,
      "env": true,
      "read": true,
      "write": true
    },
    "cli": {
      "read": true,
      "write": true,
      "env": true,
      "sys": [
        "hostname",
        "cpus"
      ],
      "net": [
        "127.0.0.1"
      ],
      "run": [
        "deno",
        "npm"
      ]
    },
    "websocket-plugin": {
      "net": true
    },
    "realtime-backplane-plugin": {
      "read": true,
      "import": true,
      "env": true,
      "net": true,
      "run": [
        "docker"
      ]
    },
    "diagnostics-plugin": {
      "read": true,
      "env": true,
      "net": [
        "127.0.0.1"
      ]
    }
  },
  "imports": {
    "@std/expect": "jsr:@std/expect@^1.0.20",
    "@std/testing": "jsr:@std/testing@^1.0.19",
    "vitest": "./vitest-shim.ts",
    "zod-v4": "npm:zod@^4.6.6",
    "@vitest/coverage-v8": "npm:@vitest/coverage-v8@5.0.3",
    "esbuild": "npm:esbuild@0.28.2",
