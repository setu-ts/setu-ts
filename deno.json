{
  "workspace": [
    "./packages/common",
    "./packages/kernel",
    "./packages/runtime",
    "./packages/exceptions",
    "./packages/di-plugin",
    "./packages/decorator-plugin",
    "./packages/logger-plugin",
    "./packages/config-plugin",
    "./packages/validation-plugin",
    "./packages/database-plugin",
    "./packages/cache-plugin",
    "./packages/events-plugin",
    "./packages/cqrs-plugin",
    "./packages/messaging-plugin",
    "./packages/queue-plugin",
    "./packages/auth-plugin",
    "./packages/http-security-plugin",
    "./packages/scheduler-plugin",
    "./packages/metrics-plugin",
    "./packages/health-plugin",
    "./packages/openapi-plugin",
    "./packages/telemetry-plugin",
    "./packages/secrets-plugin",
    "./packages/audit-plugin",
    "./packages/resilience-plugin",
    "./packages/storage-plugin",
    "./packages/mail-plugin",
    "./packages/notification-plugin",
    "./packages/feature-flags-plugin",
    "./packages/multi-tenancy-plugin",
    "./packages/testing",
    "./packages/cli",
    "./packages/create",
    "./packages/sdk",
    "./packages/starters/rest-starter",
    "./packages/starters/microservice-starter",
    "./packages/starters/full-stack-starter",
    "./packages/sse-plugin",
    "./packages/react-router-plugin",
    "./packages/worker-pool-plugin",
    "./packages/websocket-plugin",
    "./packages/realtime-backplane-plugin",
    "./packages/session-plugin",
    "./packages/service-discovery-plugin",
    "./packages/grpc-plugin",
    "./packages/cloudflare-plugin",
    "./packages/graphql-plugin",
    "./packages/static-plugin",
    "./packages/view-plugin",
    "./packages/localization-plugin",
    "./packages/diagnostics-plugin",
    "./packages/idempotency-plugin"
  ],
  "nodeModulesDir": "none",
  "tasks": {
    "check": "deno check packages",
    "check:apps": "deno run --allow-read --allow-run --allow-env=ALLOW_SKIP scripts/check-apps.ts",
    "check:browser": "deno run --allow-read=.,$HOME/.cache/ms-playwright,$HOME/Library/Caches/ms-playwright,/etc/os-release,/etc/lsb-release --allow-write=.tmp/browser --allow-env --allow-sys=hostname,cpus,osRelease,uid,gid,homedir --allow-run=deno apps/full-stack/browser/harness.ts",
    "check:docs": "deno run --allow-read --allow-run scripts/check-docs.ts && deno run --allow-read --allow-run scripts/check-prose-assertions.ts && deno run --allow-read --allow-run=deno --allow-write=.tmp scripts/check-example-behaviour.ts && deno run --allow-read --allow-net=jsr.io,registry.npmjs.org scripts/check-since-tags.ts && deno run --allow-read --allow-run=git scripts/check-changelog-coverage.ts && deno run --allow-read --allow-run --allow-env scripts/generate-api-docs.ts --check",
    "check:since-tags": "deno run --allow-read --allow-net=jsr.io,registry.npmjs.org scripts/check-since-tags.ts",
    "check:changelog-coverage": "deno run --allow-read --allow-run=git scripts/check-changelog-coverage.ts",
    "check:api-docs": "deno run --allow-read --allow-run --allow-env scripts/generate-api-docs.ts --check",
    "check:compat": "SETU_TEST_MEMBER=packages/validation-plugin pnpm exec vitest run packages/validation-plugin/test/unit/validation-service.test.ts && SETU_TEST_MEMBER=packages/openapi-plugin pnpm exec vitest run packages/openapi-plugin/test/unit/zod-to-openapi.test.ts packages/openapi-plugin/test/unit/zod4-to-openapi.test.ts packages/openapi-plugin/test/unit/zod4-dedup.test.ts packages/openapi-plugin/test/integration/openapi-zod4-integration.test.ts && SETU_TEST_MEMBER=packages/database-plugin pnpm exec vitest run packages/database-plugin/test/integration/real-import.test.ts packages/database-plugin/test/integration/real-drizzle-adapter.test.ts",
    "check:script-coverage": "deno run --allow-run=deno scripts/script-coverage.ts coverage",
    "docs:api": "deno run --allow-read --allow-run --allow-write --allow-env scripts/generate-api-docs.ts",
    "release:docs": "deno run --allow-read --allow-run --allow-write --allow-env scripts/generate-api-docs.ts",
    "check:plan": "deno run --allow-read scripts/plan-lint.ts",
    "check:node-build": "deno run --allow-run=pnpm,npm,npx,node,bun,tar --allow-read --allow-write=.tmp --allow-env --allow-net=127.0.0.1 scripts/check-node-build.ts",
    "check:versions": "deno run --allow-read --allow-run=git scripts/version-sweep.ts",
    "check:deploy": "deno run --allow-read --allow-write --allow-run --allow-env --allow-sys=hostname --allow-net=jsr.io,127.0.0.1,registry.npmjs.org scripts/check-deploy.ts",
    "deploy:render": "deno run --allow-read --allow-write --allow-run --allow-env scripts/check-deploy.ts --render --write",
    "test": "deno run --allow-read --allow-run=deno scripts/test-partition.ts --root-only",
    "test:coverage": "deno run --allow-read --allow-write=coverage --allow-run=deno scripts/test-root-coverage.ts",
    "test:coverage:pkg": "deno run --allow-run=pnpm --allow-read=. --allow-write=coverage-node scripts/test-node.ts --coverage",
    "audit": "deno audit --level=high",
    "audit:ci": "deno run --allow-run=deno scripts/audit.ts",
    "release:verify": "deno run --allow-read --allow-run=git scripts/verify-release.ts",
    "release:bump": "deno run --allow-read --allow-write --allow-run=git,deno scripts/bump-version.ts",
    "release:verify-repos": "deno run --allow-read --allow-net=api.jsr.io scripts/verify-jsr-repos.ts",
    "release:resolved-set": "deno run --allow-read --allow-write scripts/release-resolved-set.ts",
    "dependency:drift": "deno run --allow-read scripts/dependency-drift.ts",
    "release:create-packages": "deno run --allow-read --allow-env=JSR_TOKEN,JSR_API_BASE --allow-net=api.jsr.io scripts/create-jsr-packages.ts",
    "release:placeholders": "deno run --allow-read --allow-write=.tmp scripts/write-npm-placeholders.ts",
    "release:publish": "deno run --allow-read --allow-write=.tmp --allow-env=GITHUB_ACTIONS --allow-net=registry.npmjs.org --allow-run=pnpm,npm,tar scripts/npm-publish.ts",
    "release:link-repos": "deno run --allow-read --allow-env=JSR_TOKEN,JSR_API_BASE,JSR_REPO_OWNER,JSR_REPO_NAME --allow-net=api.jsr.io scripts/link-jsr-repos.ts",
    "release:archive-old-scope": "deno run --allow-env=JSR_TOKEN,JSR_API_BASE,JSR_OLD_SCOPE --allow-net=api.jsr.io scripts/archive-old-scope.ts",
    "release:set-metadata": "deno run --allow-read --allow-env=JSR_TOKEN,JSR_API_BASE --allow-net=api.jsr.io scripts/set-jsr-metadata.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "docs:exports": "deno run --allow-read --allow-write --allow-run=deno scripts/generate-package-exports.ts",
    "test:deno-lane": "deno run --allow-read --allow-write=coverage-deno-lane --allow-run=deno scripts/test-deno-lane.ts"
  },
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true
  },
  "exclude": [
    "apps/full-stack/build",
    "packages/*/dist",
    "packages/starters/*/dist",
    "scripts/codemods"
  ],
  "lint": {
    "exclude": [
      "website",
      "scripts/codemods",
      "vitest.config.ts",
      "test/node"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "no-eval",
        "no-sync-fn-in-async-fn",
        "no-console",
        "verbatim-module-syntax"
      ]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "semiColons": true,
    "exclude": [
      "pnpm-lock.yaml",
      "docs/api",
      ".verify",
      ".verify-milestone",
      "k8s/chart/templates",
      "k8s/manifests",
      "website"
    ]
  },
  "imports": {
    "@std/expect": "jsr:@std/expect@^1.0.20",
    "@std/testing": "jsr:@std/testing@^1.0.19",
    "vitest": "npm:vitest@5.0.3",
    "zod-v3": "npm:zod@^3.24.0",
    "zod-v4": "npm:zod@^4.4.0",
    "@vitest/coverage-v8": "npm:@vitest/coverage-v8@5.0.3",
    "esbuild": "npm:esbuild@0.28.2",
    "xml-crypto": "npm:xml-crypto@^6",
    "ioredis": "npm:ioredis@5.x",
    "@simplewebauthn/server": "npm:@simplewebauthn/server@14.0.3",
    "drizzle-orm": "npm:drizzle-orm@0.45.2",
    "pg": "npm:pg@^8.0.0",
    "@google-cloud/bigtable": "npm:@google-cloud/bigtable@^6",
    "@azure/cosmos": "npm:@azure/cosmos@^4",
    "@aws-sdk/client-dynamodb": "npm:@aws-sdk/client-dynamodb@^3",
    "@prisma/client": "npm:@prisma/client@7.8.0",
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@^7.10.0",
    "mongodb": "npm:mongodb@^6.21.0",
    "graphql": "npm:graphql@^16",
    "@opentelemetry/api": "npm:@opentelemetry/api@^1.9.0",
    "@opentelemetry/sdk-trace-base": "npm:@opentelemetry/sdk-trace-base@^2.9.0",
    "@opentelemetry/resources": "npm:@opentelemetry/resources@^2.9.0",
    "pino": "npm:pino@10.x",
    "nodemailer": "npm:nodemailer@^10",
    "@google-cloud/pubsub": "npm:@google-cloud/pubsub@^6",
    "amqplib": "npm:amqplib@0.10.x",
    "kafkajs": "npm:kafkajs@2.x",
    "nats": "npm:nats@2.x",
    "@aws-sdk/client-sqs": "npm:@aws-sdk/client-sqs@^3",
    "react-router": "npm:react-router@8",
    "@hono/node-server": "npm:@hono/node-server@^2.0.0",
    "@aws-sdk/client-secrets-manager": "npm:@aws-sdk/client-secrets-manager@^3",
    "@aws-sdk/client-s3": "npm:@aws-sdk/client-s3@^3",
    "@opentelemetry/exporter-trace-otlp-http": "npm:@opentelemetry/exporter-trace-otlp-http@^0.220.0",
    "drizzle-orm/": "npm:drizzle-orm@0.45.2/"
  },
  "publish": {
    "exclude": [
      "**/test"
    ]
  }
}
