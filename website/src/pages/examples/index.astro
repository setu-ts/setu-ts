---
import { getEntry } from 'astro:content';
import RepositoryArticle from '../../components/RepositoryArticle.astro';
import { APPS } from '../../lib/repository';
const entry = await getEntry('repository', 'apps/README.md');
if (!entry?.rendered) throw new Error('Missing apps/README.md');
---
<RepositoryArticle html={entry.rendered.html} directory="apps">
  <p><a href="/docs/examples/">Example walkthroughs and learning path</a></p>
  <ul>{APPS.map((app) => <li><a href={`/examples/${app}/`}>{app}</a></li>)}</ul>
</RepositoryArticle>
