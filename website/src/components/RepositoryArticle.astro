---
import DocsLayout from '../layouts/DocsLayout.astro';
import { extractDescription, extractTableOfContents, extractTitle, rewriteDocsHtml } from '../lib/docs-links';
import { EXAMPLE_FILES } from '../lib/repository';
interface Props { html: string; directory: string; title?: string }
const { html: source, directory, title: suppliedTitle } = Astro.props;
const html = rewriteDocsHtml(source, directory, EXAMPLE_FILES);
const title = suppliedTitle ?? extractTitle(html) ?? 'Setu-TS';
---
<DocsLayout title={`${title} — Setu-TS`} description={extractDescription(html)} tableOfContents={extractTableOfContents(html)}>
  <article class="prose" set:html={html} />
  <slot />
</DocsLayout>
