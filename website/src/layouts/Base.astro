---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Plugin-first enterprise backend framework built on Hono.' } =
  Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const isDocs = Astro.url.pathname.startsWith('/docs');
const softwareApplicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Setu-TS',
  operatingSystem: 'Cross-platform',
  applicationCategory: 'DeveloperApplication',
  description:
    'Plugin-first enterprise backend framework built on Hono for Node.js, Deno, Bun, and Cloudflare Workers.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/setu-ts-favicon-64.png" type="image/png" />
    <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Setu-TS" />
    <script type="application/ld+json" set:html={JSON.stringify(softwareApplicationSchema)}></script>
    <script src="/pagefind/pagefind-component-ui.js" type="module"></script>
    <script is:inline>
      // Set the theme before first paint to avoid a flash of the wrong palette.
      (() => {
        let theme = 'light';
        try {
          if (window.matchMedia?.('(prefers-color-scheme: dark)').matches) {
            theme = 'dark';
          }
          const stored = localStorage.getItem('setu-theme');
          if (stored === 'light' || stored === 'dark') {
            theme = stored;
          }
        } catch {
          // Browser storage can be unavailable; retain the system preference.
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="inner">
        <a href="/" class="brand-link" aria-label="Setu-TS home">
          <img
            class="header-mark"
            src="/setu-ts-favicon-64.png"
            alt=""
            width="32"
            height="32"
            aria-hidden="true"
          />
          <span>Setu-TS</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <pagefind-modal-trigger
            class="site-search"
            placeholder="Search docs"
          ></pagefind-modal-trigger>
          <a href="/docs/" aria-current={isDocs ? 'page' : undefined}>Docs</a>
          <a href="/api/">API</a>
          <a href="/docs/examples/">Examples</a>
          <a href="https://github.com/setu-ts/setu-ts">GitHub</a>
          <button
            id="theme-toggle"
            class="theme-toggle"
            type="button"
            aria-label="Toggle color theme"
          >
            <svg
              class="icon-moon"
              aria-hidden="true"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="currentColor"
            >
              <path
                d="M6.2 1.6a6.5 6.5 0 1 0 8.2 8.2A7 7 0 0 1 6.2 1.6Z"></path></svg
            >
            <svg
              class="icon-sun"
              aria-hidden="true"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="currentColor"
            >
              <path
                d="M8 4.5A3.5 3.5 0 1 0 8 11.5 3.5 3.5 0 0 0 8 4.5Zm0-3.5h0a.6.6 0 0 1 .6.6v1.2a.6.6 0 0 1-1.2 0V1.6A.6.6 0 0 1 8 1Zm0 11.6a.6.6 0 0 1 .6.6v1.2a.6.6 0 0 1-1.2 0v-1.2a.6.6 0 0 1 .6-.6ZM1 8a.6.6 0 0 1 .6-.6h1.2a.6.6 0 0 1 0 1.2H1.6A.6.6 0 0 1 1 8Zm11.6 0a.6.6 0 0 1 .6-.6h1.2a.6.6 0 0 1 0 1.2h-1.2a.6.6 0 0 1-.6-.6ZM3.1 3.1a.6.6 0 0 1 .85 0l.85.85a.6.6 0 0 1-.85.85l-.85-.85a.6.6 0 0 1 0-.85Zm7.1 7.1a.6.6 0 0 1 .85 0l.85.85a.6.6 0 0 1-.85.85l-.85-.85a.6.6 0 0 1 0-.85Zm.85-7.1a.6.6 0 0 1 0 .85l-.85.85a.6.6 0 0 1-.85-.85l.85-.85a.6.6 0 0 1 .85 0Zm-7.1 7.1a.6.6 0 0 1 0 .85l-.85.85a.6.6 0 0 1-.85-.85l.85-.85a.6.6 0 0 1 .85 0Z"></path></svg
            >
          </button>
        </nav>
        <pagefind-modal-trigger
          class="mobile-search-toggle"
          compact
          hide-shortcut
          aria-label="Search docs"
        ></pagefind-modal-trigger>
        <details class="mobile-navigation">
          <summary aria-label="Open navigation">
            <svg
              aria-hidden="true"
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="1.8"
            >
              <path d="M3 5.5h14M3 10h14M3 14.5h14"></path>
            </svg>
            <span class="visually-hidden">Open navigation</span>
          </summary>
          <div class="mobile-navigation-panel">
            <a href="/docs/" aria-current={isDocs ? 'page' : undefined}>Docs</a>
            <a href="/api/">API</a>
            <a href="/docs/examples/">Examples</a>
            <a href="https://github.com/setu-ts/setu-ts">GitHub</a>
            <button
              class="theme-toggle mobile-theme-toggle"
              type="button"
              aria-label="Toggle color theme"
            >
              <svg
                class="icon-moon"
                aria-hidden="true"
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="currentColor"
              >
                <path
                  d="M6.2 1.6a6.5 6.5 0 1 0 8.2 8.2A7 7 0 0 1 6.2 1.6Z"
                ></path></svg
              >
              <svg
                class="icon-sun"
                aria-hidden="true"
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="currentColor"
              >
                <path
                  d="M8 4.5A3.5 3.5 0 1 0 8 11.5 3.5 3.5 0 0 0 8 4.5Zm0-3.5h0a.6.6 0 0 1 .6.6v1.2a.6.6 0 0 1-1.2 0V1.6A.6.6 0 0 1 8 1Zm0 11.6a.6.6 0 0 1 .6.6v1.2a.6.6 0 0 1-1.2 0v-1.2a.6.6 0 0 1 .6-.6ZM1 8a.6.6 0 0 1 .6-.6h1.2a.6.6 0 0 1 0 1.2H1.6A.6.6 0 0 1 1 8Zm11.6 0a.6.6 0 0 1 .6-.6h1.2a.6.6 0 0 1 0 1.2h-1.2a.6.6 0 0 1-.6-.6ZM3.1 3.1a.6.6 0 0 1 .85 0l.85.85a.6.6 0 0 1-.85.85l-.85-.85a.6.6 0 0 1 0-.85Zm7.1 7.1a.6.6 0 0 1 .85 0l.85.85a.6.6 0 0 1-.85.85l-.85-.85a.6.6 0 0 1 0-.85Zm.85-7.1a.6.6 0 0 1 0 .85l-.85.85a.6.6 0 0 1-.85-.85l.85-.85a.6.6 0 0 1 .85 0Zm-7.1 7.1a.6.6 0 0 1 0 .85l-.85.85a.6.6 0 0 1-.85-.85l-.85-.85a.6.6 0 0 1 0-.85Z"
                ></path></svg
              >
              <span>Theme</span>
            </button>
          </div>
        </details>
      </div>
    </header>

    <main id="main" data-pagefind-body>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="inner">
        <span>MIT License © Setu-TS Contributors</span>
        <nav aria-label="Footer">
          <a href="https://github.com/setu-ts/setu-ts/blob/main/CHANGELOG.md">Changelog</a>
          <a href="https://github.com/setu-ts/setu-ts#contributing">Contributing</a>
          <a href="https://github.com/setu-ts/setu-ts">Repository</a>
        </nav>
      </div>
    </footer>

    <pagefind-modal reset-on-close></pagefind-modal>

    <script>
      /** Switches the colour theme and retains the choice when storage is available. */
      function toggleTheme() {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('setu-theme', next);
        } catch {
          // Private mode: the toggle still works for this page view.
        }
      }

      for (const toggle of document.querySelectorAll('.theme-toggle')) {
        toggle.addEventListener('click', toggleTheme);
      }
    </script>
  </body>
</html>
