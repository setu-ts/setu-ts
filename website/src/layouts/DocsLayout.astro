---
import Base from './Base.astro';
import DocsNavigation from '../components/DocsNavigation.astro';
import SectionNavigation, {
  type SectionNavigationGroup,
} from '../components/SectionNavigation.astro';
import type { TableOfContentsItem } from '../lib/docs-links';

/** One step of the breadcrumb trail above the page title; the page itself is not a step. */
export interface Breadcrumb {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  /** Canonical file in docs/, for the "edit on GitHub" link. */
  source?: string;
  /** Headings in the rendered article, for in-page navigation. */
  tableOfContents?: TableOfContentsItem[];
  /** Where the page sits, for the trail above the title. Omitted on guides. */
  breadcrumbs?: Breadcrumb[];
  /** Replaces the guides sidebar with this section's own pages (examples, packages). */
  section?: SectionNavigationGroup[];
}

const { title, description, source, tableOfContents = [], breadcrumbs = [], section } =
  Astro.props;
const pageLabel = title.replace(/ — Setu-TS$/, '');
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/docs';
const sourceFile = source?.toLowerCase() === 'readme' ? 'README' : source;
const editUrl = source
  ? `https://github.com/setu-ts/setu-ts/edit/main/docs/${sourceFile}.md`
  : undefined;
---

<Base title={title} description={description}>
  <div class="docs-shell">
    <aside class="docs-sidebar">
      {
        section ? (
          <SectionNavigation groups={section} currentPath={currentPath} />
        ) : (
          <DocsNavigation currentPath={currentPath} />
        )
      }
    </aside>
    <div class="docs-content">
      <div class="docs-mobile-controls">
        <details class="docs-sidebar-mobile">
          <summary>
            <svg
              aria-hidden="true"
              width="14"
              height="14"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="1.8"
            >
              <path d="M3 5.5h14M3 10h14M3 14.5h14"></path>
            </svg>
            Menu
          </summary>
          {
        section ? (
          <SectionNavigation groups={section} currentPath={currentPath} />
        ) : (
          <DocsNavigation currentPath={currentPath} />
        )
      }
        </details>
        {
          tableOfContents.length > 0 && (
          <details class="page-toc">
            <summary>
              On this page
              <span aria-hidden="true">›</span>
            </summary>
            <nav aria-label="On this page">
              <ul>
                {tableOfContents.map((item) => (
                  <li class:list={[`toc-level-${item.level}`]}>
                    <a href={`#${item.id}`}>{item.title}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
          )
        }
      </div>
      {
        editUrl && (
          <a class="edit-page" href={editUrl}>
            Edit this page on GitHub
          </a>
        )
      }
      {
        breadcrumbs.length > 0 && (
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <ol>
              {breadcrumbs.map((crumb) => (
                <li>
                  <a href={crumb.href}>{crumb.label}</a>
                </li>
              ))}
              <li aria-current="page">{pageLabel}</li>
            </ol>
          </nav>
        )
      }
      <slot />
    </div>
  </div>
</Base>
