{
  "nodeModulesDir": "auto",
  "imports": {
    "@std/expect": "jsr:@std/expect@^1.0.20",
    "@std/testing/bdd": "jsr:@std/testing@^1.0.19/bdd"
  },
  "fmt": {
    "singleQuote": true
  },
  "tasks": {
    "install": "deno install --min-dep-age 0",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 node node_modules/astro/astro.js dev",
    "build": "cd .. && deno task docs:api && cd website && ASTRO_TELEMETRY_DISABLED=1 node node_modules/astro/astro.js build && node scripts/graft.mjs && node node_modules/pagefind/lib/runner/bin.cjs --site dist",
    "preview": "node node_modules/astro/astro.js preview",
    "test": "deno test -A test/",
    "lint": "deno lint src test scripts",
    "fmt:check": "deno fmt --check src test scripts *.mjs"
  }
}
