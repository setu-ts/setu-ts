# Docker build context excludes.
#
# Every image builds from the REPOSITORY ROOT: Dockerfiles copy the pnpm workspace
# manifest, frozen lockfile, TypeScript configuration, packages and example apps.
# A root context keeps those workspace dependencies available during the build.

.git
.github
.claude

# Generated API documentation: ~380 KB of HTML that no image ever reads.
docs/api

# Test and coverage output.
coverage
**/cov_profile

# Frontend build output and npm trees (apps/full-stack). Regenerated by the build that needs them.
**/node_modules
apps/*/build
apps/*/.wrangler

# Legacy compiled executable; current Node SEA output is excluded under .tmp below.
apps/compiled-binary/hono-example

# Editor and OS noise.
.vscode
.idea
**/.DS_Store

# Repository tooling scratch and build output never enter an image.
.tmp
coverage-node
coverage-deno-lane
**/dist
# Incremental build state: without dist it would tell tsc -b the image is already built.
**/*.tsbuildinfo
