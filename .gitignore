# Coverage output (root `deno task test:coverage` writes coverage/; per-package
# runs with `--coverage=.coverage` write .coverage/ — ignore both at any depth).
coverage/
.coverage/
.cov/
cov/
coverage.lcov

# Generated API docs
docs/api/

# Verification reports + scratch drivers (verify-milestone skill output — scratch,
# never committed per CLAUDE.md's plan-cleanup rule; also fmt-excluded in deno.json).
.verify/
.verify-*/

# npm compatibility artifacts (compat test suites)
node_modules/

# Environment files
.env
.env.*
!.env.example

# Editor/OS noise
.DS_Store
.idea/
*.swp

# Workspace-local scratch/temporary files (see .roo/rules/03-temp-files.md)
.tmp/

# Wrangler's local state, written by apps/cloudflare's smoke check. Untracked it
# would dirty the tree and make a following `deno task publish:check` abort.
.wrangler/

# The frontend build and its resolved npm graph, written by apps/full-stack's
# smoke check (which builds for real rather than committing a ServerBuild
# fixture). Same reason as .wrangler/ above: untracked output dirties the tree
# ahead of `publish:check`. The lockfile is ignored deliberately — CI resolves
# the declared ranges fresh, so a range that stops working fails loudly instead
# of being pinned around.
apps/full-stack/build/
apps/full-stack/.react-router/
apps/full-stack/deno.lock

# Claude Code local state (worktree checkouts, personal settings). Nothing
# under .claude/ is meant to be tracked today; if shared project config is
# added later (e.g. .claude/settings.json), un-ignore it with a negation.
.claude/
