# The SEA embeds Node. A glibc builder is required for the distroless runtime.
FROM node:24-bookworm AS build
ARG APP=compiled-binary
WORKDIR /srv
RUN npm install --global pnpm@12.11.2
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages ./packages
COPY scripts ./scripts
COPY apps ./apps
RUN pnpm install --frozen-lockfile --filter setu-ts-example-${APP}...
RUN pnpm --filter setu-ts-example-${APP} run build:sea

FROM gcr.io/distroless/cc-debian12
USER 65532:65532
COPY --from=build --chown=65532:65532 /srv/.tmp/compiled-binary/server /server
EXPOSE 3000
ENTRYPOINT ["/server"]
CMD ["3000"]
